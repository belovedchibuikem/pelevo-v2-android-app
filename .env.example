# Pelevo payment and withdrawal gateways.
# Put these on the API server (Forge / .env). Leave them empty here and paste
# the live values only on the server. Do not commit a filled .env, and do not
# put secret keys in the Flutter app.

# --- Google Play: Pelevo Plus and gift-coin purchases (API server .env) ---
# Play Console → Setup → API access → service account JSON path.
# Receipts: POST /premium/store-purchase and POST /iap/verify (store=google).
GOOGLE_PACKAGE_NAME=com.Podemeraldltd.pelevo
GOOGLE_PLAY_CREDENTIALS=
FINANCE_PUBLIC_ENABLED=true

# --- App Store: Pelevo Plus and gift-coin purchases ---
# App Store Connect → Users and Access → Integrations → In-App Purchase.
# Receipts are confirmed with POST /premium/store-purchase (store=apple).
APPLE_BUNDLE_ID=com.Podemeraldltd.pelevo
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SHARED_SECRET=

# Product IDs used by the app (create these in both stores):
# pelevo_plus_individual (+ monthly/yearly base plans on Play)
# pelevo_plus_monthly / pelevo_plus_yearly (App Store)
# coins_300 … coins_2000

# --- Flutterwave: listener and creator NGN bank withdrawals ---
# Dashboard → Settings → API Keys, plus the webhook secret hash.
# Webhook URL: https://pelevo.com/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=

# --- PayPal: listener and creator USD withdrawals ---
# Developer Dashboard → Apps & Credentials, plus the webhook id.
# Webhook URL: https://pelevo.com/webhooks/paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Paystack is not a Pelevo payout or checkout account. Do not set Paystack keys.
