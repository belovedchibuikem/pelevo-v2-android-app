# Pelevo payment and withdrawal gateways.
# Put these on the API server (Forge / .env). Leave them empty here and paste
# the live values only on the server. Do not commit a filled .env, and do not
# put secret keys in the Flutter app.

# --- Google Play: Pelevo Plus and gift-coin purchases ---
# Play Console → Setup → API access → service account JSON.
# Receipts are confirmed with POST /premium/store-purchase (store=google).
GOOGLE_PLAY_PACKAGE_NAME=com.Podemeraldltd.pelevo
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- App Store: Pelevo Plus and gift-coin purchases ---
# App Store Connect → Users and Access → Integrations → In-App Purchase.
# Receipts are confirmed with POST /premium/store-purchase (store=apple).
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SHARED_SECRET=

# Product IDs already used by the app (create these in both stores):
# pelevo_plus_monthly
# pelevo_plus_yearly
#
# Set these Plus monthly prices manually in App Store Connect and Play Console.
# Do not let either store auto-convert a Nigeria base of ₦1,600.
#   Nigeria              NGN 1,600
#   South Africa         ZAR 69.99
#   Kenya                KES 399 on one storefront, KES 419 on the other
#   Ghana                GHS 24
#   Egypt                EGP 79
#   Morocco              MAD 49
#   Ivory Coast          XOF 1,800
#   Cameroon             XAF 1,800
#   USD fallback stores  USD 2.99
#     (Tanzania, Uganda, and other countries without a native currency
#     storefront. Override the auto-converted amount.)
# The app displays the formatted price the signed-in store account returns.
# pelevo_coins_500
# pelevo_coins_1200
# pelevo_coins_2500
# pelevo_coins_6500
# pelevo_coins_15000

# --- Paystack: listener and creator NGN bank withdrawals ---
# Dashboard → Settings → API Keys & Webhooks.
# Webhook URL: https://pelevo.com/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- PayPal: listener and creator USD withdrawals ---
# Developer Dashboard → Apps & Credentials, plus the webhook id.
# Webhook URL: https://pelevo.com/webhooks/paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Flutterwave is shown in the app and is not a live payout gateway.
# The withdraw setup screen does not submit a Flutterwave account.
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# FLUTTERWAVE_ENCRYPTION_KEY=
